{
  "openapi": "3.0.1",
  "info": {
    "title": "ISI Reporting EAI",
    "description": "ISI Reporting EAI - Service zum Befüllen der Metabase-DB",
    "contact": { "name": "ISI Management", "email": "unbekannt@muenchen.de" },
    "version": "1.2.0"
  },
  "servers": [{ "url": "http://localhost:8088", "description": "Generated server url" }],
  "tags": [
    { "name": "EtlInterfaceEai", "description": "API zum Aufruf von ETL-Kommandos." },
    {
      "name": "AbfrageReportingEai",
      "description": "API zum Speichern von Abfragen mit reportingrelevanten Informationen."
    }
  ],
  "paths": {
    "/etl": {
      "post": {
        "tags": ["EtlInterfaceEai"],
        "summary": "Triggert einen ETL-Job der ausgeführt werden soll",
        "operationId": "triggerJob",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EtlTriggerJobDto" } } },
          "required": true
        },
        "responses": {
          "200": { "description": "ETL-Interface Aufruf erfolgreich" },
          "555": {
            "description": "CUSTOM INTERNAL SERVER ERROR -> Bei der Ausführung des ETL-Interface-Requests ist ein serverseitiger Fehler aufgetreten.",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/InformationResponseDto" } } }
          }
        }
      }
    },
    "/abfrage": {
      "post": {
        "tags": ["AbfrageReportingEai"],
        "summary": "Speichert Abfragen mit reportingrelevanten Informationen.",
        "operationId": "save",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AbfrageDto" } } },
          "required": true
        },
        "responses": { "200": { "description": "OK -> Abfrage gespeichert." } }
      }
    },
    "/abfrage/{id}": {
      "delete": {
        "tags": ["AbfrageReportingEai"],
        "summary": "Löscht eine Abfrage mitsamt aller reportingrelevanten Informationen.",
        "operationId": "delete",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          {
            "name": "art-abfrage",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["UNSPECIFIED", "BAULEITPLANVERFAHREN", "BAUGENEHMIGUNGSVERFAHREN", "WEITERES_VERFAHREN"]
            }
          }
        ],
        "responses": { "204": { "description": "NO CONTENT" } }
      }
    }
  },
